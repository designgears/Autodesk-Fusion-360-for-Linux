+#include <poll.h>
+#include <X11/extensions/Xdamage.h>
+
+/* the driver presents asynchronously, wait until the new frame lands in the child window before copying it */
+static void wait_present_damage( Window window )
+{
+    static int enabled = -1, damage_event;
+    static Display *damage_display;
+    static struct { Window window; BOOL pending; } slots[16];
+    struct timespec start, now;
+    int i, slot = -1, remaining, error;
+
+    if (enabled < 0)
+        enabled = (damage_display = XOpenDisplay( NULL )) && XDamageQueryExtension( damage_display, &damage_event, &error );
+    if (!enabled || !window) return;
+
+    for (i = 0; i < ARRAY_SIZE(slots); i++) if (slots[i].window == window) { slot = i; break; }
+    if (slot < 0)
+    {
+        for (i = 0; i < ARRAY_SIZE(slots); i++) if (!slots[i].window) { slot = i; break; }
+        if (slot < 0) return;
+        slots[slot].window = window;
+        XDamageCreate( damage_display, window, XDamageReportNonEmpty );
+        XSync( damage_display, False );
+        return;
+    }
+    slots[slot].pending = TRUE;
+
+    clock_gettime( CLOCK_MONOTONIC, &start );
+    for (;;)
+    {
+        while (XPending( damage_display ))
+        {
+            XEvent event;
+            XNextEvent( damage_display, &event );
+            if (event.type != damage_event + XDamageNotify) continue;
+            for (i = 0; i < ARRAY_SIZE(slots); i++)
+            {
+                XDamageNotifyEvent *notify = (XDamageNotifyEvent *)&event;
+                if (slots[i].window != notify->drawable) continue;
+                slots[i].pending = FALSE;
+                XDamageSubtract( damage_display, notify->damage, None, None );
+            }
+        }
+        if (!slots[slot].pending) break;
+        clock_gettime( CLOCK_MONOTONIC, &now );
+        remaining = 100 - ((now.tv_sec - start.tv_sec) * 1000 + (now.tv_nsec - start.tv_nsec) / 1000000);
+        if (remaining <= 0) { slots[slot].pending = FALSE; break; }
+        {
+            struct pollfd pfd = { ConnectionNumber( damage_display ), POLLIN, 0 };
+            XFlush( damage_display );
+            poll( &pfd, 1, remaining );
+        }
+    }
+}
+
