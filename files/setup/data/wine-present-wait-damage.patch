+#include <dlfcn.h>
+#include <poll.h>
+
+/* libXdamage is loaded at runtime so building does not need it, the wait is skipped without it */
+typedef XID Damage;
+typedef struct
+{
+    int type;
+    unsigned long serial;
+    Bool send_event;
+    Display *display;
+    Drawable drawable;
+    Damage damage;
+    int level;
+    Bool more;
+    Time timestamp;
+    XRectangle area;
+    XRectangle geometry;
+} XDamageNotifyEvent;
+
+static Bool (*pXDamageQueryExtension)( Display *display, int *event_base, int *error_base );
+static Damage (*pXDamageCreate)( Display *display, Drawable drawable, int level );
+static void (*pXDamageSubtract)( Display *display, Damage damage, XID repair, XID parts );
+
+/* the driver presents asynchronously, wait until the new frame lands in the child window before copying it */
+static void wait_present_damage( Window window )
+{
+    static int enabled = -1, damage_event;
+    static Display *damage_display;
+    static struct { Window window; BOOL pending; } slots[16];
+    struct timespec start, now;
+    int i, slot = -1, remaining, error;
+
+    if (enabled < 0)
+    {
+        void *handle = dlopen( "libXdamage.so.1", RTLD_NOW );
+        enabled = handle && (pXDamageQueryExtension = dlsym( handle, "XDamageQueryExtension" )) &&
+                  (pXDamageCreate = dlsym( handle, "XDamageCreate" )) &&
+                  (pXDamageSubtract = dlsym( handle, "XDamageSubtract" )) &&
+                  (damage_display = XOpenDisplay( NULL )) &&
+                  pXDamageQueryExtension( damage_display, &damage_event, &error );
+    }
+    if (!enabled || !window) return;
+
+    for (i = 0; i < ARRAY_SIZE(slots); i++) if (slots[i].window == window) { slot = i; break; }
+    if (slot < 0)
+    {
+        for (i = 0; i < ARRAY_SIZE(slots); i++) if (!slots[i].window) { slot = i; break; }
+        if (slot < 0) return;
+        slots[slot].window = window;
+        pXDamageCreate( damage_display, window, 3 /* XDamageReportNonEmpty */ );
+        XSync( damage_display, False );
+        return;
+    }
+    slots[slot].pending = TRUE;
+
+    clock_gettime( CLOCK_MONOTONIC, &start );
+    for (;;)
+    {
+        while (XPending( damage_display ))
+        {
+            XEvent event;
+            XNextEvent( damage_display, &event );
+            if (event.type != damage_event /* + XDamageNotify */) continue;
+            for (i = 0; i < ARRAY_SIZE(slots); i++)
+            {
+                XDamageNotifyEvent *notify = (XDamageNotifyEvent *)&event;
+                if (slots[i].window != notify->drawable) continue;
+                slots[i].pending = FALSE;
+                pXDamageSubtract( damage_display, notify->damage, None, None );
+            }
+        }
+        if (!slots[slot].pending) break;
+        clock_gettime( CLOCK_MONOTONIC, &now );
+        remaining = 100 - ((now.tv_sec - start.tv_sec) * 1000 + (now.tv_nsec - start.tv_nsec) / 1000000);
+        if (remaining <= 0) { slots[slot].pending = FALSE; break; }
+        {
+            struct pollfd pfd = { ConnectionNumber( damage_display ), POLLIN, 0 };
+            XFlush( damage_display );
+            poll( &pfd, 1, remaining );
+        }
+    }
+}
+
 static void X11DRV_client_surface_present( struct client_surface *client, HDC hdc )
 {
     struct x11drv_client_surface *surface = impl_from_client_surface( client );
@@ -401,6 +487,7 @@ static void X11DRV_client_surface_present( struct client_surface *client, HDC hd
         set_dc_drawable( surface->hdc_dst, window, &rect_dst, IncludeInferiors );
     if (region) NtGdiExtSelectClipRgn( surface->hdc_dst, region, RGN_COPY );
 
+    wait_present_damage( surface->window );
     NtGdiStretchBlt( surface->hdc_dst, 0, 0, rect_dst.right - rect_dst.left, rect_dst.bottom - rect_dst.top,
                      surface->hdc_src, 0, 0, rect_src.right - rect_src.left, rect_src.bottom - rect_src.top, SRCCOPY, 0 );
     XFlush( gdi_display );
