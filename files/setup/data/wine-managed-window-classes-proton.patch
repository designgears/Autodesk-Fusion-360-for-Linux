+                         NtUserGetWindowRelative( hwnd, GW_OWNER ),
+                         (int)(rect.right - rect.left), (int)(rect.bottom - rect.top),
+                         (int)rect.left, (int)rect.top, ret ? "managed" : "unmanaged" );
+    }
+    return ret;
+}
