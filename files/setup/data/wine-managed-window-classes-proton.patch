  *
  * Check if a given window should be managed
  */
-static BOOL is_window_managed( HWND hwnd, UINT swp_flags, BOOL fullscreen )
+static BOOL class_is_forced_managed( HWND hwnd )
+{
+    static const char *list;
+    static BOOL initialized;
+
+    WCHAR class_name[64];
+    UNICODE_STRING str = { .Buffer = class_name, .MaximumLength = sizeof(class_name) };
+    char buffer[64];
+    const char *p;
+    unsigned int i;
+    DWORD style;
+
+    if (!initialized)
+    {
+        list = getenv( "WINE_X11_MANAGED_CLASSES" );
+        initialized = TRUE;
+    }
+    if (!list || !*list) return FALSE;
+
+    style = NtUserGetWindowLongW( hwnd, GWL_STYLE );
+    if ((style & (WS_CHILD|WS_POPUP)) == WS_CHILD) return FALSE;
+
+    memset( class_name, 0, sizeof(class_name) );
+    if (NtUserGetClassName( hwnd, FALSE, &str ) <= 0) return FALSE;
+
+    for (i = 0; i < sizeof(buffer) - 1 && class_name[i]; i++) buffer[i] = (char)class_name[i];
+    buffer[i] = 0;
+
+    for (p = list; *p;)
+    {
+        const char *end = strchr( p, ',' );
+        size_t len = end ? (size_t)(end - p) : strlen( p );
+
+        if (len && len == strlen( buffer ) && !strncmp( p, buffer, len )) return TRUE;
+        p = end ? end + 1 : p + len;
+    }
+    return FALSE;
+}
+
+
+/* Translucent overlays must not be activation targets, the WM raises them over the dialog they dim. */
+BOOL class_is_forced_managed_overlay( HWND hwnd )
+{
+    DWORD ex_style;
+
+    if (!class_is_forced_managed( hwnd )) return FALSE;
+    /* Both flags: the dialog is layered too, but is not a tool window and must stay activatable. */
+    ex_style = NtUserGetWindowLongW( hwnd, GWL_EXSTYLE );
+    return (ex_style & (WS_EX_LAYERED|WS_EX_TOOLWINDOW)) == (WS_EX_LAYERED|WS_EX_TOOLWINDOW);
+}
+
